# Korea-first live POI providers
KAKAO_REST_API_KEY=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
GOOGLE_MAPS_API_KEY=

# Public Data Portal (data.go.kr)
# Use the decoded/general service key. Atlas uses this first for HIRA official hospital data.
DATA_GO_KR_SERVICE_KEY=

# SGIS official population / establishment statistics
# SGIS issues a Service ID (consumer key) and Service Secret.
SGIS_CONSUMER_KEY=
SGIS_CONSUMER_SECRET=

# Optional map style. Defaults to MapLibre demo style in the MVP.
NEXT_PUBLIC_MAP_STYLE_URL=
